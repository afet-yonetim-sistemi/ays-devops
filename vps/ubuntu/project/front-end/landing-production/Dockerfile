# Stage 1: Base image used by all later stages
FROM node:24.12.0-alpine AS base

# Stage 2: Dependencies stage (installs node_modules once, then reused)
FROM base AS deps
WORKDIR /app

# Copy only dependency manifests to leverage Docker layer caching
COPY package.json package-lock.json ./

# Install dependencies exactly from package-lock.json (reproducible install)
RUN npm ci

# Stage 3: Builder stage (creates the production build output)
FROM base AS builder
WORKDIR /app

# Reuse installed dependencies from the deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy the rest of the application source code
COPY . .

# Disable Next.js telemetry (kept as-is; harmless even if this is not Next.js)
ENV NEXT_TELEMETRY_DISABLED=1

# Build the app (for CRA this generates the /app/build folder)
RUN npm run build

# Stage 4: Runner stage (minimal runtime to serve the built static files)
FROM base AS runner
WORKDIR /app

# Keep these lines as you requested (even if they are not used by CRA runtime)
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/public ./

# Copy the production build output generated by npm run build
COPY --from=builder /app/build ./build

# Create the nextjs:nodejs user/group so the --chown line does not fail
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

# Install a simple static file server to serve the build/ directory
RUN npm i -g serve

# Expose the application port
EXPOSE 19791
ENV PORT=19791

# Start serving the static build output on port 19791
CMD ["serve", "-s", "build", "-l", "19791"]
